#!/usr/bin/env python3
"""Entrypoint launcher for Thauthi (resolves symlinks portably across macOS/Linux)."""
import os
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

try:
    from thauthi.cli import main
except BaseException as e:
    if any(arg == "hook" for arg in sys.argv[1:2]):
        if os.environ.get("THAUTHI_DEBUG"):
            sys.stderr.write(f"[thauthi:hook-fallback] Failed to load thauthi: {e}\n")
        sys.exit(0)
    raise

if __name__ == "__main__":
    try:
        sys.exit(main())
    except BaseException as e:
        if any(arg == "hook" for arg in sys.argv[1:2]):
            if os.environ.get("THAUTHI_DEBUG"):
                sys.stderr.write(f"[thauthi:hook-fallback] Hook execution error: {e}\n")
            sys.exit(0)
        raise
